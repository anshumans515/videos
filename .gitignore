# Editing intermediates — regenerate with the project's build_base.sh.
# Leading **/ matters: a pattern containing a slash is anchored to this file's
# directory, so plain `public/...` would only match a public/ at the repo root.
**/public/input-video.mp4
**/public/snapshots/
*.wav
saver.mp4
saver_loop.mp4
spender.mp4

# Upload-ready renders in projects/ ARE committed: they are the deliverable,
# and they cannot be rebuilt from this repo alone (the camera source lives
# outside it). The full-bitrate render master is not — film grain pushes it
# past 50 MB, it re-encodes to output-ig.mp4 in seconds, and Instagram
# re-encodes on ingest regardless.
projects/**/output.mp4
templates/**/output.mp4
templates/**/cover.png

# HyperFrames per-render scratch dirs
**/work-*/

# Node
package-lock.json

# OS / editor cruft
.DS_Store
node_modules/
