node_modules/
# out/* (not out/) so the negation below can carve one file back in — git
# never looks inside a directory matched by a bare "dir/" pattern, so
# "!out/birthday-final-web.mp4" would silently do nothing against "out/".
out/*
chunks/
.remotion/
*.log
# The finished deliverable IS committed. The full-bitrate render master
# (out/birthday-final.mp4, ~560MB — 1080x1920/13min at near-lossless CRF is
# just large) stays ignored; regenerate it with render_chunks.sh if needed.
!out/birthday-final-web.mp4
# The source video Remotion trims all 14 speaker slices out of. It's a copy
# of ../projects/birthday-messages/public/messages-merged.mp4 (172MB
# — well past what belongs in git). See README for how to regenerate it.
public/
